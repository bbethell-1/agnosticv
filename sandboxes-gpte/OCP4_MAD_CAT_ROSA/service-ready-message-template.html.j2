<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
   <head>
      <title></title>
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <style type="text/css">#outlook a { padding:0; }
         body { margin:0;padding:0;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%; }
         table, td { border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt; }
         img { border:0;height:auto;line-height:100%; outline:none;text-decoration:none;-ms-interpolation-mode:bicubic; }
         p { display:block;margin:13px 0; }
      </style>
      <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Text&display=swap" rel="stylesheet" type="text/css">
      <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet" type="text/css">
      <style type="text/css">@import url(https://fonts.googleapis.com/css2?family=Red+Hat+Text&display=swap);
         @import url(https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700&display=swap);
      </style>
      <style type="text/css">@media only screen and (min-width:480px) {
         .mj-column-per-100 { width:100% !important; max-width: 100%; }
         }
      </style>
      <style type="text/css">@media only screen and (max-width:480px) {
         table.full-width-mobile { width: 100% !important; }
         td.full-width-mobile { width: auto !important; }
         }
         th {border: 2px solid white;border-radius: 20px;padding: 10px 5px 10px 5px;
            font-family: Red Hat Display;font-size:14px;font-weight:700;
            line-height:1;text-align: center;word-break:break-word;
          }
          td {border-radius: 20px;border: 2px solid white;padding: 10px 5px 10px 5px;
            font-family: Red Hat Display;font-size:14px;
            text-align: center;line-height:1;word-break:break-word;}
      </style>
  </head>
  <body>
    <!-- Main -->
    <div style="margin:0px auto;max-width:800px;border: 1px dashed #151515;">
      <!-- Company Header -->
      <table align="center"  cellpadding="0" cellspacing="0" role="presentation" style="background:#151515;width:100%;">
        <tbody>
          <tr>
            <td style="text-align:right;">
              <a href="https://demo.redhat.com/" target="_blank"><img alt="RedHat" title="RedHat" width=185 src="https://gpte-public.s3.amazonaws.com/CI+Assets/icons_and_logos/redhat_red_logo.png"></a>
            </td>
          </tr>
        </tbody>
      </table>
        <!-- Empty/space -->
      <div style="margin:0px auto;max-width:650px;height:10px;">&nbsp;</div>
      <!-- Service status -->
      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
              <tr>
                <td style="color:#000000;font-weight:700;font-size:16px;">
                  Status: Service Ready
                </td>
              </tr>
              <tr>
                <td style="color:#000000;font-size:32px;font-weight:700;line-height:2;word-break:break-word; ">
                  {{ service_display_name }}
                </td>
              </tr>
          </tbody>
        </table>
      </div>
      <!-- Empty/space -->
      <div style="margin:0px auto;max-width:650px;height:50px;">&nbsp;</div>

      <!-- Service status -->

      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
              <tr>
                <td style="color:#ffffff;background:#f40e0e;font-weight:700;font-size:16px;border-radius:0;text-align:left;">
                  Lab Access ...
                </td>
              </tr>
              <tr>
                <td style="color:#000000;background:#F3F3F3;font-weight:300;font-size:14px;border-radius:0;text-align:left;line-height:2;">
                  Hello! Welcome to the Modern App Dev Roadshow - Cloud Architect Track for ROSA!
		  To access your all-in-one lab environment all you need to do is visit your unique Lab URL: <br>
		  {{ showroom_primary_view_url }}                 
 
                </td>
              </tr>
          </tbody>
        </table>
      </div>


{% if rosa_token_warning %}
      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
            <tr><td colspan="2" style="background:#ffffff;"></td></tr>
            <tr>
              <td colspan="2" style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                You did not provide a ROSA token.<br><br>
                This is fine as long as you do not need to access the managment console at
                https://console.redhat.com/openshift. <br><br>
                For future deployments you can provide a token for this access. <br><br>
                You can generate a rosa token from your Red Hat console account here: https://console.redhat.com/openshift/token/rosa
              </td>
            </tr>
{% endif %}

          </tbody>
        </table>
      </div>
       <!-- Empty/space -->
      <div style="margin:0px auto;max-width:650px;height:50px;">&nbsp;</div>
        <!-- Copy Right -->
      <table align="center"  cellpadding="0" cellspacing="0" role="presentation" style=";border:0px;background:#151515;width:100%;padding:0 0 0 0;text-align:center;">
        <tbody>
          <tr>
            <td style="text-align:right;">
              <a href="https://www.redhat.com/en" target="_blank"><img alt="Red Hat" title="Red Hat" width=50 src="https://gpte-public.s3.amazonaws.com/CI+Assets/icons_and_logos/redhat_red_logo.png"></a>
            </td>
            <td style="color:#F3F3F3;border: 0px;font-size:12px;text-align:left;">
              © 2022 Red Hat, Inc.
            </td>
        </tbody>
      </table>

    </div>
    <!-- Main end -->
    <!-- Empty/space -->
    &nbsp;
  </body>
</html>
