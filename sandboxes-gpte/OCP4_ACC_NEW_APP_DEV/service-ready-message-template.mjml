<!-- Company Header -->
<mj-section full-width="full-width" background-color="#151515" padding-top="8px" padding-bottom="8px" padding-left="12px" padding-right="12px">
  <mj-group>
    <mj-column vertical-align="middle">
      <mj-image href="https://demo.redhat.com/" title="RedHat" alt="RedHat" width="185px" src="https://public-assets-email.s3.us-east-2.amazonaws.com/Logo-Red_Hat-A-Reverse-RGB.png"/>
    </mj-column>
  </mj-group>
</mj-section>
<!-- spacer -->
<mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
  <mj-column>
    <mj-spacer height="25px"/>
  </mj-column>
</mj-section>
<!-- Title -->
<mj-section padding-top="21px" padding-bottom="12px" padding-left="12px" padding-right="12px">
  <mj-column>
    <mj-text font-family="Red Hat Text" font-weight="regular" align="center" font-size="16px" color="#000" line-height="1.2">
      Status: Service Ready
    </mj-text>
    <mj-text font-family="Red Hat Display" font-weight="regular" align="center" font-size="35px" color="#000" line-height="1.2">
      {{ service_display_name }}
    </mj-text>
  </mj-column>
</mj-section>
<!-- spacer -->
<mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
  <mj-column>
    <mj-spacer height="25px"/>
  </mj-column>
</mj-section>
<!-- spacer -->
<mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
  <mj-column>
    <mj-spacer height="25px"/>
  </mj-column>
</mj-section>
<!-- Text -->
<mj-section padding-top="12px" padding-bottom="12px" padding-left="12px" padding-right="12px" background-color="#f0f0f0">
  <mj-column>
    <mj-text font-family="Red Hat Text" color="#4a5557" font-size="16px" line-height="1.5">
      NOTICE:
    </mj-text>
  </mj-column>
</mj-section>
<mj-section padding-top="12px" padding-bottom="12px" padding-left="12px" padding-right="12px" background-color="#f0f0f0">
  <mj-column>
    <mj-text font-family="Red Hat Text" color="#4a5557" font-size="16px" line-height="1.5" padding-bottom="12px">
      This service is scheduled to stop and be retired:
    </mj-text>
    <mj-text font-family="Red Hat Text" color="#4a5557" font-size="16px" line-height="1.5" padding-bottom="12px">
      Scheduled stop in {{ stop_timedelta_humanized }} at {{ stop_timestamp }}
    </mj-text>
    <mj-text font-family="Red Hat Text" color="#4a5557" font-size="16px" line-height="1.5" padding-bottom="12px">
      Scheduled retirement in {{ retirement_timedelta_humanized }} at {{ retirement_timestamp }}.
    </mj-text>
  </mj-column>
</mj-section>

<!-- spacer -->
<mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
  <mj-column>
    <mj-spacer height="25px"/>
  </mj-column>
</mj-section>

<!-- Subtitle -->

  <mj-section padding-right="0" padding-left="0" padding-top="0" padding-bottom="0" background-color="rgba(238,0,0,0)" border="1 solid black">
    <mj-column>
      <mj-text font-family="Red Hat Display" padding-top="12px" font-size="16px" color="#f8f8f8" padding-bottom="11px" padding-left="10px" container-background-color="#f40e0e" font-weight="700">
      General Demo Access Information
      </mj-text>
    </mj-column>
  </mj-section>

<!-- Details block -->
<mj-wrapper border="1px solid #ccc" border-radius="8px" padding-top="0" padding-left="0" padding-right="0" padding-bottom="0">
  <mj-section padding-right="12px" padding-left="12px" padding-top="0" padding-bottom="20px">
    <mj-column>

      <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        <b>OpenShift Console:</b>
        </br>{{ openshift_console_url }}
      </mj-text>
      <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
        <b>username: </b> {{ openshift_cluster_admin_username }}
      </mj-text>
      <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
        <b>password: </b> {{ openshift_cluster_admin_password }}
      </mj-text>

      <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        <b>OpenShift Login Command:</b>
      </mj-text>
      <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
        <b>oc login -u {{ openshift_cluster_admin_username }} -p {{ openshift_cluster_admin_password }} {{ openshift_api_url }}</b>
      </mj-text>

      <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        <b>Visual Studio Code Server:</b>
        </br>{{ visual_studio_code_server }}
      </mj-text>
      <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
        <b>password: </b> {{ visual_studio_code_password }}
      </mj-text>

      <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        <b>Quarkus Superheroes UI:</b>
        </br>{{ heroes_super_ui }}
      </mj-text>

    </mj-column>
  </mj-section>
</mj-wrapper

<!-- spacer -->
<mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
  <mj-column>
    <mj-spacer height="25px"/>
  </mj-column>
</mj-section>

<!-- Box 1 -->
<mj-wrapper border="1px solid #ccc" border-radius="8px" padding-top="0" padding-left="0" padding-right="0" padding-bottom="0">
  <mj-section padding-right="0" padding-left="0" padding-top="0" padding-bottom="0" background-color="rgba(238,0,0,0)" border="0 solid black">
    <mj-column>
      <mj-text font-family="Red Hat Display" padding-top="12px" font-size="16px" color="#f8f8f8" padding-bottom="11px" padding-left="10px" container-background-color="#f40e0e" font-weight="700">
        Demo Summary
      </mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding-right="12px" padding-left="12px" padding-top="0" padding-bottom="20px">
    <mj-column>
      <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        <b draggable="true">This demo covers the top challenges addressed by the sales play.</b>
      </mj-text>
      <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        <b draggable="true">As a prerequisite to delivering this demo, it is expected that a thorough review of the sales play has been completed, and you are approaching the "Meeting 3" portion of this play.</b>
      </mj-text>
      <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        <b draggable="true">The full documentation, including information about its purpose, how to run the demo, scenarios that can be demoed, videos, and supporting slides:</b>
      </mj-text>
      <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#06c">
        <a style="text-decoration: none; color: #06c;" href="https://docs.google.com/document/d/1MuCCACwTMbEQgnyvhQCZi6gQ1Wlut7dN2NGk3V-O7Xo">Link to documentation</a>
      </mj-text>
    </mj-column>
  </mj-section>
</mj-wrapper>

 <!-- spacer -->
  <mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
    <mj-column>
      <mj-spacer height="25px" />
    </mj-column>
  </mj-section>

  <!-- Box 2 -->
  <mj-wrapper border="1px solid #ccc" border-radius="8px" padding-top="0" padding-left="0" padding-right="0" padding-bottom="0">
    <mj-section padding-right="0" padding-left="0" padding-top="0" padding-bottom="0" background-color="rgba(238,0,0,0)" border="0 solid black">
      <mj-column>
        <mj-text font-family="Red Hat Display" padding-top="12px" font-size="16px" color="#f8f8f8" padding-bottom="11px" padding-left="10px" container-background-color="#f40e0e" font-weight="700">
          Detailed Access Information
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding-right="12px" padding-left="12px" padding-top="0" padding-bottom="20px">
      <mj-column>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>Apicurio Quarkus Superheroes:</b>
          </br>{{ heroes_apicurio }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>ArgoCD Quarkus Superheroes:</b>
          </br>{{ heroes_argocd }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>Events Stats Quarkus Superheroes:</b>
          </br>{{ heroes_events_stats }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>OpenShift Pipelines Quarkus Superheroes:</b>
          </br>{{ heroes_pipelines }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>Prometheus Quarkus Superheroes:</b>
          </br>{{ heroes_prometheus }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>Quarkus Superheroes UI:</b>
          </br>{{ heroes_super_ui }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>Gitea:</b>
          </br>{{ gitea_console_url }}
        </mj-text>
        <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
          <b>username: </b> {{ gitea_admin_username }}
        </mj-text>
        <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
          <b>password: </b> {{ openshift }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>OpenShift Console:</b>
          </br>{{ openshift_console_url }}
        </mj-text>
        <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
          <b>username: </b> {{ openshift_cluster_admin_username }}
        </mj-text>
        <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
          <b>password: </b> {{ openshift_cluster_admin_password }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>OpenShift Login Command:</b>
        </mj-text>
        <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
          <b>oc login -u {{ openshift_cluster_admin_username }} -p {{ openshift_cluster_admin_password }} {{ openshift_api_url }}</b>
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>Visual Studio Code Server:</b>
          </br>{{ visual_studio_code_server }}
        </mj-text>
        <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
          <b>password: </b> {{ visual_studio_code_password }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>Linux Bastion:</b>
          </br>ssh {{ bastion_ssh_user_name }}@{{ bastion_public_hostname }}</span>
        </mj-text>
        <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
          <b>password: </b> {{ bastion_ssh_password }}
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <b>Service management URL:</b>
          </br><a style="text-decoration: none; color: #06c;" href="{{ service_url }}">{{ service_url }}</a>
        </mj-text>

      </mj-column>
    </mj-section>
  </mj-wrapper>

<!-- spacer -->
<mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
  <mj-column>
    <mj-spacer height="25px"/>
  </mj-column>
</mj-section>
