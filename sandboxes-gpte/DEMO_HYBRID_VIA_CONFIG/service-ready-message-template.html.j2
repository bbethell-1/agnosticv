
<link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700&family=Red+Hat+Text&display=swap" rel="stylesheet">
<script type="module">
  import "https://unpkg.com/@patternfly/pfe-card?module";
  import "https://unpkg.com/@patternfly/pfe-cta?module";
  import "https://unpkg.com/@patternfly/pfe-clipboard?module"
  import "https://unpkg.com/@patternfly/pfe-icon?module";
  import "https://unpkg.com/@patternfly/pfe-icon-panel?module";
  import "https://unpkg.com/@patternfly/pfe-codeblock?module";
  import "https://unpkg.com/@patternfly/pfe-band?module";
  import "https://unpkg.com/@patternfly/pfe-label?module";
</script>
<script>
    function multipleLinks() {
      const links = ['http://google.com', 'http://yahoo.com'];
      for (let i = 0; i < links.length; i++) {
        window.open(links[i]);
      }
    }
</script>
<style>
  :root {
    --redhat-color: rgb(238, 0, 0);
    --pf-global--FontFamily--sans-serif: "Red Hat Text","Overpass",overpass,helvetica,arial,sans-serif;
    --pf-global--FontFamily--heading--sans-serif: "Red Hat Display", "Overpass", overpass, helvetica, arial, sans-serif;
    --pfe-theme--color--surface--base: var(--redhat-color);
    --pfe-card__header--BackgroundColor: var(--redhat-color);
    --pfe-card--Border: 1px solid var(--redhat-color);

  }
  :root {
    font-family: var(--pf-global--FontFamily--sans-serif);
    font-size: var(--pf-global--FontSize--sm);
    text-align: left;
    color: var(--pf-global--Color--100);
  }
  h1, h2 {
    font-family: var(--pf-global--FontFamily--heading--sans-serif);
  }
  h3, h4 {
    font-weight: 500;
    color: #fff;
  }
</style>

<pfe-band color="lightest">
  <pfe-icon-panel icon="rh-cloud">
    <h2 slot="pfe-icon-panel--header">{{ service_display_name }}</h2>
    <p>Status: <pfe-label color="green">Service Ready</pfe-label></p>
  </pfe-icon-panel>
</pfe-band>


<pfe-band size="small">
  <h4>This service is scheduled to stop and be retired:</h4>
  <ul>
    <li>Scheduled stop in {{ stop_timedelta_humanized }} at {{ stop_timestamp }}</li>
    <li>Scheduled retirement in {{ retirement_timedelta_humanized }} at {{ retirement_timestamp }}.</li>
    </ul>
</pfe-band>

{% if openshift_console_url %}
<pfe-band color="lightest" size="small">
  <h2 color="#000" slot="pfe-band--header">General Demo Access Information</h3>
  <ul>
    <li>OpenShift Console:
      <pfe-clipboard copy-from="{{ openshift_console_url }}">
        <span slot="text">{{ openshift_console_url }}</span>
      </pfe-clipboard>
    </li>
    <li>RHACM Console:
      <pfe-clipboard copy-from="{{ acm_route }}">
        <span slot="text">{{ acm_route }}</span>
      </pfe-clipboard>
      <ul>
        <li>username: {{ openshift_cluster_admin_username }} </li>
        <li>password: {{ openshift_cluster_admin_password }} </li>
      </ul>
    </li>
    <li>Visual Studio Code Server:
      <pfe-clipboard copy-from="{{ visual_studio_code_server }}">
        <span slot="text">{{ visual_studio_code_server }}</span>
      </pfe-clipboard>
      <ul>
        <li>password: {{ visual_studio_code_password }}</li>
      </ul>
    </li>
  </ul>
</pfe-band>
{% endif %}

<pfe-band color="lightest">
  <pfe-accordion expanded-index="1" disclosure="true">
    <pfe-accordion-panel>

{% if openshift_console_url %}
  <pfe-card color="lightest">
    <h3 slot="pfe-card--header">Segment 1: Stability and Speed Anywhere</h3>
    <p>
      <pfe-cta>
        <a href="https://docs.google.com/document/d/1RN7oefDysW7j9vjvpuiwtGDcuXU_tC8wN9oOcVaybp8/edit#bookmark=id.ndm5z9gdp9oi">Segment Narrative Script</a>
      </pfe-cta>
    </p>

    <p>Linux Bastion Access:
      <pfe-clipboard copy-from="ssh {{ bastion_ssh_user_name }}@{{ bastion_public_hostname }}">
        <span slot="text">SSH: ssh {{ bastion_ssh_user_name }}@{{ bastion_public_hostname }}</span>
      </pfe-clipboard>
      <pfe-clipboard copy-from="{{ bastion_ssh_password }}">
        <span slot="text">Password: {{ bastion_ssh_password }}</span>
      </pfe-clipboard>
    </p>

    <p>OpenShift Console:
      <pfe-clipboard copy-from="{{ openshift_console_url }}">
        <span slot="text">URL:
          <pfe-cta>
            <a href="{{ openshift_console_url }}" target="_blank">{{ openshift_console_url }}</a>
          </pfe-cta>
        </span>
      </pfe-clipboard>
      <pfe-clipboard copy-from="{{ openshift_cluster_admin_username }}">
        <span slot="text">Username: {{ openshift_console_username }}</span>
      </pfe-clipboard>
      <pfe-clipboard copy-from="{{ openshift_cluster_admin_password }}">
        <span slot="text">Password: {{ openshift_console_password }}</span>
      </pfe-clipboard>
    </p>

    <p>RHACM Console:
      <pfe-clipboard copy-from="{{ acm_route }}">
        <span slot="text">URL:
          <pfe-cta>
            <a href="{{ acm_route }}" target="_blank">{{ acm_route }}</a>
          </pfe-cta>
        </span>
      </pfe-clipboard>
      <pfe-clipboard copy-from="{{ openshift_cluster_admin_username }}">
        <span slot="text">Username: {{ openshift_console_username }}</span>
      </pfe-clipboard>
      <pfe-clipboard copy-from="{{ openshift_cluster_admin_password }}">
        <span slot="text">Password: {{ openshift_console_password }}</span>
      </pfe-clipboard>
    </p>
  </pfe-card>
    </pfe-accordion-panel>
    </pfe-accordion>
</pfe-band>
{% endif %}

