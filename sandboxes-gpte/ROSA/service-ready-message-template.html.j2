      <!-- Service status -->

      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
              <tr>
                <td style="color:#ffffff;background:#f40e0e;font-weight:700;font-size:16px;border-radius:0;text-align:left;">
                  NOTICE
                </td>
              </tr>
              <tr>
                <td style="color:#000000;background:#F3F3F3;font-weight:300;font-size:14px;border-radius:0;text-align:left;line-height:2;">
                  This service is scheduled to be retired: <br>
                  Scheduled retirement in {{ retirement_timedelta_humanized }} at {{ retirement_timestamp }}.<br>
                  As ROSA is a managed environment, it cannot be stopped.  Please delete this environment as soon as you no longer have need for it.
                </td>
              </tr>
          </tbody>
        </table>
      </div>

      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
            <tr><td colspan="2" style="background:#ffffff;"></td></tr>
            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Information About Your ROSA Environment
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                ROSA Console URL
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ rosa_openshift_console_url }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                ROSA Admin Username
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ rosa_openshift_admin_user }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                ROSA Admin Password
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ rosa_openshift_admin_password }}
              </td>
            </tr>

            <tr><td colspan="2" style="background:#ffffff;"></td></tr>
            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Information About Your AWS Web Console Access
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                AWS Web Console URL
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                https://{{ rosa_sandbox_account_id }}.signin.aws.amazon.com/console
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                AWS Web Console Username
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ rosa_console_user_name }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                AWS Web Console Password
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ rosa_console_password }}
              </td>
            </tr>
            <tr>
              <td colspan="2" style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                Please be very careful to not expose AWS credentials in GIT repos or anywhere else that could be public!<br>
                If your credentials are compromised, your environment will be deleted <b>without warning</b>, a case will be opened with Red Hat Infosec, and your cost center will be liable for any charges.
              </td>
            </tr>

            <tr><td colspan="2" style="background:#ffffff;"></td></tr>
            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Information About Your Bastion Host
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                SSH command for bastion
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                ssh {{ rosa_bastion_user_name }}@bastion.{{ rosa_subdomain_base }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                Bastion SSH password
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ rosa_user_password }}
              </td>
            </tr>
            <tr>
              <td colspan="2" style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                Your AWS credentials are preconfigured in <pre>~/.aws/credentials</pre> on the bastion host.<br>
                The ROSA CLI is preinstalled on the bastion host in <pre>/usr/local/bin</pre>. There is no need to use root.
              </td>
            </tr>

{% if rosa_token_warning %}
            <tr>
              <td colspan="2" style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                You did not provide a ROSA token.<br><br>
                This is fine as long as you do not need to access the managment console at
                https://console.redhat.com/openshift. It is recommended that you generate and provide your own ROSA token when deploying
                this catalog item so that you have full functionality and control of your cluster. You can generate a rosa token from
                your Red Hat console account here: https://console.redhat.com/openshift/token/rosa
              </td>
            </tr>
{% endif %}

          </tbody>
        </table>
      </div>
