<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
   <head>
      <title></title>
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <style type="text/css">#outlook a { padding:0; }
         body { margin:0;padding:0;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%; }
         table, td { border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt; }
         img { border:0;height:auto;line-height:100%; outline:none;text-decoration:none;-ms-interpolation-mode:bicubic; }
         p { display:block;margin:13px 0; }
      </style>
      <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Text&display=swap" rel="stylesheet" type="text/css">
      <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet" type="text/css">
      <style type="text/css">@import url(https://fonts.googleapis.com/css2?family=Red+Hat+Text&display=swap);
         @import url(https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700&display=swap);
      </style>
      <style type="text/css">@media only screen and (min-width:480px) {
         .mj-column-per-100 { width:100% !important; max-width: 100%; }
         }
      </style>
      <style type="text/css">@media only screen and (max-width:480px) {
         table.full-width-mobile { width: 100% !important; }
         td.full-width-mobile { width: auto !important; }
         }
         th {border: 2px solid white;border-radius: 20px;padding: 10px 5px 10px 5px;
            font-family: Red Hat Display;font-size:14px;font-weight:700;
            line-height:1;text-align: center;word-break:break-word;
          }
          td {border-radius: 20px;border: 2px solid white;padding: 10px 5px 10px 5px;
            font-family: Red Hat Display;font-size:14px;
            text-align: center;line-height:1;word-break:break-word;}
      </style>
  </head>
  <body>
    <!-- Main -->
    <div style="margin:0px auto;max-width:800px;border: 1px dashed #151515;">
      <!-- Company Header -->
      <table align="center"  cellpadding="0" cellspacing="0" role="presentation" style="background:#151515;width:100%;">
        <tbody>
          <tr>
            <td style="text-align:right;">
              <a href="https://demo.redhat.com/" target="_blank"><img alt="RedHat" title="RedHat" width=185 src="https://gpte-public.s3.amazonaws.com/CI+Assets/icons_and_logos/redhat_red_logo.png"></a>
            </td>
          </tr>
        </tbody>
      </table>
        <!-- Empty/space -->
      <div style="margin:0px auto;max-width:650px;height:10px;">&nbsp;</div>
      <!-- Service status -->
      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
              <tr>
                <td style="color:#000000;font-weight:700;font-size:16px;">
                  Status: Service Ready
                </td>
              </tr>
              <tr>
                <td style="color:#000000;font-size:32px;font-weight:700;line-height:2;word-break:break-word; ">
                  {{ service_display_name }}
                </td>
              </tr>
          </tbody>
        </table>
      </div>
      <!-- Empty/space -->
      <div style="margin:0px auto;max-width:650px;height:50px;">&nbsp;</div>

      <!-- Service status -->

      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
              <tr>
                <td style="color:#ffffff;background:#f40e0e;font-weight:700;font-size:16px;border-radius:0;text-align:left;">
                  NOTICE
                </td>
              </tr>
              <tr>
                <td style="color:#000000;background:#F3F3F3;font-weight:300;font-size:14px;border-radius:0;text-align:left;line-height:2;">
                  This service is scheduled to be retired: <br>
                  Scheduled retirement in {{ retirement_timedelta_humanized }} at {{ retirement_timestamp }}.<br>
                  GCP Blank OPEN Environment environment cannot be stopped via the RHDP UI.  You must manage instances on your own.<br>
                  Help Red Hat save money and please stop instances when not in use and delete this environment as soon as you no longer have need for it.
                </td>
              </tr>
          </tbody>
        </table>
      </div>

      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
            <tr><td colspan="2" style="background:#ffffff;"></td></tr>
            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Information About Your GCP Blank OPEN Environment
              </td>
            </tr>
            <tr>
              <td colspan=2 style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                We have temporarily allocated GCP project {{ gcp_project }} to you.<br>
                You can log into <a href="https://console.cloud.google.com/home/dashboard?project={{ gcp_project }}&organizationId={{ gcp_organization }}" target=_blank>https://console.cloud.google.com/home/dashboard?project={{ gcp_project }}&organizationId={{ gcp_organization }}</a> using your Red Hat SSO credentials.<br>
                NOTE: When this OPEN environment expires, the project and all of its contents will be destroyed.  All data will be irrecovably removed. Please regularly back up your data and script your changes in case you need to rebuild.<br>
                NOTE: It can take a few minutes for your project to become visible in the GCP Web UI.
              </td>
            </tr>
            <tr><td colspan="2" style="background:#ffffff;"></td></tr>

            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Your GCP OPEN Environment details:
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                Organization ID
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ gcp_organization }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                Project ID
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ gcp_project }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                DNS Zone
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ gcp_dns_zone }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                Service Account
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ gcp_service_account }}
              </td>
            </tr>
            <tr><td colspan="2" style="background:#ffffff;"></td></tr>

            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Save the following GCP credentials file to use the service account
              </td>
            </tr>
            <tr>
              <td colspan=2 style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                <pre>
{{ gcp_credentials_file }}
                </pre>
              </td>
            </tr>
            <tr><td colspan="2" style="background:#ffffff;"></td></tr>
            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                CLI quickstart
              </td>
            </tr>
            <tr>
              <td colspan=2 style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                <pre>
sudo tee -a /etc/yum.repos.d/google-cloud-sdk.repo << EOM
[google-cloud-cli]
name=Google Cloud CLI
baseurl=https://packages.cloud.google.com/yum/repos/cloud-sdk-el8-x86_64
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://packages.cloud.google.com/yum/doc/yum-key.gpg
       https://packages.cloud.google.com/yum/doc/rpm-package-key.gpg
EOM
sudo dnf -y install google-cloud-cli
gcloud init
                </pre>
                See https://cloud.google.com/sdk/gcloud for more info on installing the the gcloud CLI
              </td>
            </tr>

            <tr>
              <td colspan="2" style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                Please be very careful to not expose GCP credentials in GIT repos or anywhere else that could be public!<br>
                If your credential is compromised, GCP will automatically deactivate it, your environment will be deleted <b>without warning</b>, a case will be opened with Red Hat INFOSEC,
                and your cost center will be liable for any charges.
              </td>
            </tr>

          </tbody>
        </table>
      </div>
       <!-- Empty/space -->
      <div style="margin:0px auto;max-width:650px;height:50px;">&nbsp;</div>
        <!-- Copy Right -->
      <table align="center"  cellpadding="0" cellspacing="0" role="presentation" style=";border:0px;background:#151515;width:100%;padding:0 0 0 0;text-align:center;">
        <tbody>
          <tr>
            <td style="text-align:right;">
              <a href="https://www.redhat.com/en" target="_blank"><img alt="Red Hat" title="Red Hat" width=50 src="https://gpte-public.s3.amazonaws.com/CI+Assets/icons_and_logos/redhat_red_logo.png"></a>
            </td>
            <td style="color:#F3F3F3;border: 0px;font-size:12px;text-align:left;">
              © 2022 Red Hat, Inc.
            </td>
        </tbody>
      </table>

    </div>
    <!-- Main end -->
    <!-- Empty/space -->
    &nbsp;
  </body>
</html>
