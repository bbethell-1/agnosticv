      <!-- Service status -->

      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
              <tr>
                <td style="color:#ffffff;background:#f40e0e;font-weight:700;font-size:16px;border-radius:0;text-align:left;">
                  NOTICE
                </td>
              </tr>
              <tr>
                <td style="color:#000000;background:#F3F3F3;font-weight:300;font-size:14px;border-radius:0;text-align:left;line-height:2;">
                  This service is scheduled to be retired: <br>
                  Scheduled retirement in {{ retirement_timedelta_humanized }} at {{ retirement_timestamp }}.<br>
                  GCP Blank OPEN Environment environment cannot be stopped via the RHDP UI.  You must manage instances on your own.<br>
                  Help Red Hat save money and please stop instances when not in use and delete this environment as soon as you no longer have need for it.
                </td>
              </tr>
          </tbody>
        </table>
      </div>

      <div style="margin:0px auto;max-width:650px;">
