<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
   <head>
      <title></title>
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <style type="text/css">#outlook a { padding:0; }
         body { margin:0;padding:0;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%; }
         table, td { border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt; }
         img { border:0;height:auto;line-height:100%; outline:none;text-decoration:none;-ms-interpolation-mode:bicubic; }
         p { display:block;margin:13px 0; }
      </style>
      <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Text&display=swap" rel="stylesheet" type="text/css">
      <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet" type="text/css">
      <style type="text/css">@import url(https://fonts.googleapis.com/css2?family=Red+Hat+Text&display=swap);
         @import url(https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700&display=swap);
      </style>
      <style type="text/css">@media only screen and (min-width:480px) {
         .mj-column-per-100 { width:100% !important; max-width: 100%; }
         }
      </style>
      <style type="text/css">@media only screen and (max-width:480px) {
         table.full-width-mobile { width: 100% !important; }
         td.full-width-mobile { width: auto !important; }
         }
         th {border: 2px solid white;border-radius: 20px;padding: 10px 5px 10px 5px;
            font-family: Red Hat Display;font-size:14px;font-weight:700;
            line-height:1;text-align: center;word-break:break-word;
          }
          td {border-radius: 20px;border: 2px solid white;padding: 10px 5px 10px 5px;
            font-family: Red Hat Display;font-size:14px;
            text-align: center;line-height:1;word-break:break-word;}
      </style>
  </head>
  <body>

    <!-- Main -->

    <div style="margin:0px auto;max-width:800px;border: 1px dashed #151515;">
      <!-- Company Header -->
      <table align="center"  cellpadding="0" cellspacing="0" role="presentation" style="background:#151515;width:100%;">
        <tbody>
          <tr>
            <td style="text-align:right;">
              <a href="https://demo.redhat.com/" target="_blank"><img alt="RedHat" title="RedHat" width=185 src="https://gpte-public.s3.amazonaws.com/CI+Assets/icons_and_logos/redhat_red_logo.png"></a>
            </td>
          </tr>
        </tbody>
      </table>
        <!-- Empty/space -->
      <div style="margin:0px auto;max-width:650px;height:10px;">&nbsp;</div>
      <!-- Service status -->
      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
              <tr>
                <td style="color:#000000;font-weight:700;font-size:16px;">
                  Status: Service Ready
                </td>
              </tr>
              <tr>
                <td style="color:#000000;font-size:32px;font-weight:700;line-height:2;word-break:break-word; ">
                  {{ service_display_name }}
                </td>
              </tr>
          </tbody>
        </table>
      </div>
      <!-- Empty/space -->
      <div style="margin:0px auto;max-width:650px;height:50px;">&nbsp;</div>

      <!-- Service status -->

      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
              <tr>
                <td style="color:#ffffff;background:#f40e0e;font-weight:700;font-size:16px;border-radius:0;text-align:left;">
                  NOTICE
                </td>
              </tr>
              <tr>
                <td style="color:#000000;background:#F3F3F3;font-weight:300;font-size:14px;border-radius:0;text-align:left;line-height:2;">
                  This service is scheduled to stop and be retired: <br>
                  Scheduled stop in {{ stop_timedelta_humanized }} at {{ stop_timestamp }} <br>
                  Scheduled retirement in {{ retirement_timedelta_humanized }} at {{ retirement_timestamp }}.
                </td>
              </tr>
          </tbody>
        </table>
      </div>

      <!-- Section: Sales Play Assets -->

      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
              <tr>
                <td style="color:#ffffff;background:#f40e0e;font-weight:700;font-size:16px;border-radius:0;text-align:left;">
                  Demo Summary
                </td>
              </tr>
              <tr>
                <td style="color:#000000;background:#F3F3F3;font-weight:300;font-size:14px;border-radius:0;text-align:left;line-height:20px;padding-right:20px;">
                    This demo covers the top challenges addressed by the sales play: <a href="https://content.redhat.com/us/en/sales-enablement/sales-plays-overview/salesplay-modernizeexistingapps.html">link to sales play</a>.<br><br>
                    As a prerequisite to delivering this demo, it is expected that a thorough review of the sales play has been completed, and you are approaching the "Meeting 3" portion of this play.<br><br>
                    The full documentation, including information about its purpose, how to run the demo, scenarios that can be demoed, videos, and supporting slides: <a href="https://docs.google.com/document/d/1lGUgE9q4gAjeyZWb6NX6Syypg8rUPHG01w9M58ISW5k">link to documentation</a>.<br><br>
                </td>
              </tr>
          </tbody>
        </table>
      </div>


      <!-- Important Information about your Environment -->
      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
            <tr>
              <td colspan="3" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Important Information About Your Environment
              </td>
            </tr>
            <tr>
              <th style="color:#F3F3F3;background:#151515;width: 150px;border-radius:0px;">
                Description
              </th>
              <th style="color:#F3F3F3;background:#151515;width: 100px;border-radius:0px;">
                Type
              </th>
              <th style="color:#F3F3F3;background:#151515;width: 350px;border-radius:0px;">
                Details
              </th>
            </tr>
            <!-- Automation Controller -->
            <tr><td colspan="3" style="background:#ffffff;"></td></tr>
            <tr>
            <td rowspan="4" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              OpenShift
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Console URL
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ openshift_console_url }}
            </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                Username
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ openshift_cluster_admin_username }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                Password
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                {{ openshift_cluster_admin_password }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                oc login
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                oc login -u {{ openshift_cluster_admin_username }} -p {{ openshift_cluster_admin_password }} {{ openshift_api_url }}
              </td>
            </tr>

            <!-- Coolstore LEGACY -->

            <tr><td colspan="3" style="background:#ffffff;"></td></tr>
            <tr>
            <td rowspan="2" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              Coolstore LEGACY
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Topology
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ legacy_topology }}
            </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                UI
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                {{ legacy_frontend }}
              </td>
            </tr>

            <!-- Coolstore MODERN -->

            <tr><td colspan="3" style="background:#ffffff;"></td></tr>
            <tr>
            <td rowspan="2" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              Coolstore MODERN
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Topology
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ modern_topology }}
            </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                UI
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                {{ modern_frontend }}
              </td>
            </tr>

            <!-- Migration Toolkit -->

            <tr><td colspan="3" style="background:#ffffff;"></td></tr>
            <tr>
            <td rowspan="2" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              Migration Toolkits
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Tackle UI
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ mta_url }}
            </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                Forklift UI
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
                {{ mtv_url }}
              </td>
            </tr>

            <!-- Service management URL -->

            <tr><td colspan="3" style="background:#ffffff;"></td></tr>
            <tr>
            <td rowspan="2" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              Service Management
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              URL
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ service_url }}
            </td>
            </tr>

          </tbody>
        </table>
      </div>
       <!-- Empty/space -->
      <div style="margin:0px auto;max-width:650px;height:50px;">&nbsp;</div>
        <!-- Copy Right -->
      <table align="center"  cellpadding="0" cellspacing="0" role="presentation" style=";border:0px;background:#151515;width:100%;padding:0 0 0 0;text-align:center;">
        <tbody>
          <tr>
            <td style="text-align:right;">
              <a href="https://www.redhat.com/en" target="_blank"><img alt="Red Hat" title="Red Hat" width=50 src="https://gpte-public.s3.amazonaws.com/CI+Assets/icons_and_logos/redhat_red_logo.png"></a>
            </td>
            <td style="color:#F3F3F3;border: 0px;font-size:12px;text-align:left;">
              © 2022 Red Hat, Inc.
            </td>
        </tbody>
      </table>

    </div>
    <!-- Main end -->
    <!-- Empty/space -->
    &nbsp;
  </body>
</html>
