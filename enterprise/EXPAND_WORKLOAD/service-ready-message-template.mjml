  <!-- Company Header -->
  <mj-section full-width="full-width" background-color="#151515" padding-top="8px" padding-bottom="8px" padding-left="12px" padding-right="12px">
    <mj-group>
      <mj-column vertical-align="middle">
        <mj-image href="https://demo.redhat.com/" title="RedHat" alt="RedHat" width="185px" src="https://gpte-public.s3.amazonaws.com/CI+Assets/icons_and_logos/redhat_red_logo.png" />
      </mj-column>
    </mj-group>
  </mj-section>
  <!-- spacer -->
  <mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
    <mj-column>
      <mj-spacer height="25px" />
    </mj-column>
  </mj-section>
  <!-- Title -->
  <mj-section padding-top="21px" padding-bottom="12px" padding-left="12px" padding-right="12px">
    <mj-column>
      <mj-text font-family="Red Hat Display" font-weight="regular" align="center" font-size="35px" color="#000" line-height="1.2">
        {{ service_display_name }}
      </mj-text>
      <mj-text font-family="Red Hat Text" font-weight="regular" align="center" font-size="16px" color="#000" line-height="1.2">
        from Portfolio Product Marketing
      </mj-text>
    </mj-column>
  </mj-section>

  <mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
    <mj-column>
      <mj-spacer height="25px" />
    </mj-column>
  </mj-section>

  <!-- video -->
  <mj-section padding-top="0" padding-bottom="0" padding-left="0" padding-right="0">
    <mj-column>
      <mj-text font-family="Red Hat Text" font-weight="regular" align="center" font-size="16px" color="#000" line-height="1.2">Watch the <a style="color: #111;" href="https://videos.learning.redhat.com/playlist/details/1_wpzbs7al">Video Playlist (10m)</mj-text>
    </mj-column>
  </mj-section>

  <!-- {% if service_url %} -->
  <mj-section padding-right="12px" padding-left="12px" padding-top="0" padding-bottom="20px">
    <mj-column>
      <mj-text font-family="Red Hat Text" padding-top="12px" align="center" font-size="14px" color="#111">
        Get Service Information from Service management URL<br />
        <a style="text-decoration: none; color: #06c;" href="{{ service_url }}">{{ service_url }}</a>
      </mj-text>
    </mj-column>
  </mj-section>
  <!-- {% endif %} -->

  <!-- Box 1 -->
  <mj-wrapper border="1px solid #ccc" border-radius="8px" padding-top="0" padding-left="0" padding-right="0" padding-bottom="0">
    <mj-section padding-right="0" padding-left="0" padding-top="0" padding-bottom="0" background-color="rgba(238,0,0,0)" border="0 solid black">
      <mj-column>
        <mj-text font-family="Red Hat Display" padding-top="12px" font-size="16px" color="#f8f8f8" padding-bottom="11px" padding-left="10px" container-background-color="#f40e0e" font-weight="700">
          Access Information
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding-right="12px" padding-left="12px" padding-top="0" padding-bottom="20px">
      <mj-column>

        <!-- cockpit -->
        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <img src="https://gpte-public.s3.amazonaws.com/CI+Assets/Open+Hybrid+Cloud+Demo/Product_Icon-Red_Hat-RHEL_Workstation-RGB.png" width="18" align="bottom">
          <b>Cockpit</b>
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
          <b>URL:</b>
          {{ cockpit_url }}
          </br>
          <b>Username:</b>
          devops
          </br>
          <b>Password:</b>
          {{ ssh_password }}
        </mj-text>

        <!-- spacer - smol -->
        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        </mj-text>

        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111"><img src="https://gpte-public.s3.amazonaws.com/CI+Assets/Open+Hybrid+Cloud+Demo/icons8-google-docs-48.png" width="18" align="bottom"><a href="https://docs.google.com/document/d/1TUhHCtGEa24djvqFvp5raPVDQFh5ltwS13SNKZW6pzg/edit#heading=h.ipkgzwnjbp6b">Demo Guide - Google Doc</a></mj-text>

        <!-- spacer - smol -->
        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        </mj-text>

        <!-- ssh -->
        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
          <img src="https://gpte-public.s3.amazonaws.com/CI+Assets/Open+Hybrid+Cloud+Demo/Product_Icon-Red_Hat-RHEL_Workstation-RGB.png" width="18" align="bottom">
          <b>SSH Command (Optional)</b>
          </br>
        </mj-text>
        <mj-text font-family="Red Hat Text" padding-top="10px" padding-left="12px" font-size="12px" color="#111">
          <b>SSH Command:</b> <span style="text-decoration: none; color: #111;">{{ ssh_command }}</span>
          </br>
          <b>Username:</b>
          devops
          </br>
          <b>Password:</b>
          {{ ssh_password }}
        </mj-text>

        <!-- spacer - smol -->
        <mj-text font-family="Red Hat Text" padding-top="12px" font-size="14px" color="#111">
        </mj-text>

      </mj-column>
    </mj-section>
  </mj-wrapper>
