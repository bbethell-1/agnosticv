<p>Completed test for {{ catalog_display_name }}, {{ service_display_name }}.</p>

<p>NOTICE:<br>
Scheduled stop in {{ stop_timedelta_humanized }} at {{ stop_timestamp }}.<br>
Scheduled retirement in {{ retirement_timedelta_humanized }} at {{ retirement_timestamp }}.</p>

{% if provision_messages %}
<pre>{{ provision_messages | join("\n") }}</pre>
{% endif %}

{% if provision_data %}
<dl>
{%   for k, v in provision_data.items() | sort %}
<dt>{{ k | escape }}</dt>
<dd>{{ v | escape }}</dd>
{%   endfor %}
</dl>
{% endif %}

{% if service_url %}
<p>Service management URL: <a href="{{ service_url }}">{{ service_url }}</a></p>
{% endif %}
