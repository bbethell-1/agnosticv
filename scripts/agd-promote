#!/usr/bin/env bash
# Wrapper for agd-promote.py that manages a virtual environment automatically.
set -euo pipefail

VENV_DIR="/tmp/agd-promote-venv"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PYTHON_SCRIPT="${SCRIPT_DIR}/agd-promote.py"

if [[ ! -x "${VENV_DIR}/bin/python" ]] || [[ ! -x "${VENV_DIR}/bin/pip" ]]; then
    echo "Setting up virtual environment in ${VENV_DIR}..." >&2
    rm -rf "${VENV_DIR}"
    python3 -m venv "${VENV_DIR}"
fi

if ! "${VENV_DIR}/bin/python" -c "import yaml" 2>/dev/null; then
    "${VENV_DIR}/bin/pip" install --quiet pyyaml
fi

exec "${VENV_DIR}/bin/python" "${PYTHON_SCRIPT}" "$@"
