      <div style="margin:0px auto;max-width:650px;">
        <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
          <tbody>
            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Information About Your Azure Environment
              </td>
            </tr>
            <tr><td colspan="2" style="background:#ffffff;"></td></tr>

            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                Resource Group and Application Name
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                openenv-{{ guid }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                Application/Client/Service Principal ID
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ azappid }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                Password
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ azpass }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                Tenant ID
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ azure_tenant }}
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                Subscription ID
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ azure_subscription_id }}
              </td>
            </tr>
            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Azure CLI Quickstart
              </td>
            </tr>
            <tr><td colspan="2" style="background:#ffffff;"></td></tr>
            <tr>
              <td colspan=2 style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                <pre>
export GUID={guid}
export CLIENT_ID={azure_service_principal_id}
export PASSWORD='{azure_service_principal_password}'
export TENANT={azure_tenant}
export SUBSCRIPTION={azure_subscription}
export RESOURCEGROUP=openenv-{guid}
az login --service-principal -u $CLIENT_ID -p $PASSWORD --tenant $TENANT
                </pre>
              </td>
            </tr>
            <tr>
              <td colspan=2 style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                See <a href="https://docs.microsoft.com/en-us/cli/azure/install-azure-cli" target=_blank>https://docs.microsoft.com/en-us/cli/azure/install-azure-cli</a> for more info on installing the azure CLI<br>
                See <a href="https://docs.microsoft.com/en-us/cli/azure/" target=_blank>https://docs.microsoft.com/en-us/cli/azure/</a> for full documentation of the azure CLI
              </td>
            </tr>

            <tr>
              <td colspan="2" style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
                Information About Your ARO Environment
              </td>
            </tr>
            <tr><td colspan="2" style="background:#ffffff;"></td></tr>

            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                ARO Console URL
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ aro_console }}
              </td>
            </tr>

            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                ARO Admin User
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                kubeadmin
              </td>
            </tr>
            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                ARO Admin Password
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ aro_kube_password }}
              </td>
            </tr>

            <tr>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:right;">
                ARO API URL
              </td>
              <td style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                {{ aro_api }}
              </td>
            </tr>

            <tr>
              <td colspan=2 style="color:#000000;background:#F3F3F3;border-radius:0px;text-align:left;">
                NOTE: Since you now have direct access to the Azure web portal, the AAD integration with ARO defined in this guide is no longer configured.<br>
                You can now demonstrate the Azure portal using your own AD credentials.
              </td>
            </tr>

          </tbody>
        </table>
      </div>
