<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
  <title></title>
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style type="text/css">
    #outlook a {
      padding: 0;
    }

    body {
      margin: 0;
      padding: 0;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table,
    td {
      border-collapse: collapse;
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }

    img {
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
      -ms-interpolation-mode: bicubic;
    }

    p {
      display: block;
      margin: 13px 0;
    }
  </style>
  <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Text&display=swap" rel="stylesheet" type="text/css">
  <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet"
    type="text/css">
  <style type="text/css">
    @import url(https://fonts.googleapis.com/css2?family=Red+Hat+Text&display=swap);
    @import url(https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700&display=swap);
  </style>
  <style type="text/css">
    @media only screen and (min-width:480px) {
      .mj-column-per-100 {
        width: 100% !important;
        max-width: 100%;
      }
    }
  </style>
  <style type="text/css">
    @media only screen and (max-width:480px) {
      table.full-width-mobile {
        width: 100% !important;
      }

      td.full-width-mobile {
        width: auto !important;
      }
    }

    th {
      border: 2px solid white;
      border-radius: 20px;
      padding: 10px 5px 10px 5px;
      font-family: Red Hat Display;
      font-size: 14px;
      font-weight: 700;
      line-height: 1;
      text-align: center;
      word-break: break-word;
    }

    td {
      border-radius: 20px;
      border: 2px solid white;
      padding: 10px 5px 10px 5px;
      font-family: Red Hat Display;
      font-size: 14px;
      text-align: center;
      line-height: 1;
      word-break: break-word;
    }
  </style>
</head>

<body>

  <!-- Main -->

  <div style="margin:0px auto;max-width:800px;border: 1px dashed #151515;">
    <!-- Company Header -->
    <table align="center" cellpadding="0" cellspacing="0" role="presentation" style="background:#151515;width:100%;">
      <tbody>
        <tr>
          <td style="text-align:right;">
          </td>
        </tr>
      </tbody>
    </table>
    <!-- Empty/space -->
    <div style="margin:0px auto;max-width:650px;height:10px;">&nbsp;</div>
    <!-- Service status -->
    <div style="margin:0px auto;max-width:650px;">
      <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
        <tbody>
          <tr>
            <td style="color:#000000;font-weight:700;font-size:16px;">
              Status: Service Ready
            </td>
          </tr>
          <tr>
            <td style="color:#000000;font-size:32px;font-weight:700;line-height:2;word-break:break-word; ">
              {{ service_display_name }}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <!-- Empty/space -->
    <div style="margin:0px auto;max-width:650px;height:50px;">&nbsp;</div>

    <!-- Service status -->

    <div style="margin:0px auto;max-width:650px;">
      <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
        <tbody>
          <tr>
            <td
              style="color:#ffffff;background:#f40e0e;font-weight:700;font-size:16px;border-radius:0;text-align:left;">
              NOTICE
            </td>
          </tr>
          <tr>
            <td
              style="color:#000000;background:#F3F3F3;font-weight:300;font-size:14px;border-radius:0;text-align:left;line-height:2;">
              This service is scheduled to stop and be retired: <br>
              Scheduled stop in {{ stop_timedelta_humanized }} at {{ stop_timestamp }} <br>
              Scheduled retirement in {{ retirement_timedelta_humanized }} at {{ retirement_timestamp }}.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Section: Summary -->

    <div style="margin:0px auto;max-width:650px;">
      <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
        <tbody>
          <tr>
            <td
              style="color:#ffffff;background:#f40e0e;font-weight:700;font-size:16px;border-radius:0;text-align:left;">
              Summary
            </td>
          </tr>
          <tr>
            <td
              style="color:#000000;background:#F3F3F3;font-weight:300;font-size:14px;border-radius:0;text-align:left;line-height:20px;padding-right:20px;">
              <p>
                Do you need to familiarize yourself with cloud-native development, Kubernetes automation, and GitOps
                methodology?
                In this lab, we'll walk you through a complete development journey example of a 2-tier application made
                with Python and Go, built and deployed on Red Hat OpenShift.
                The full lab introduction can be found <a
                  href="https://redhat-scholars.github.io/inner-outer-guides">here</a>.
                You'll learn how to:
              </p>
              <ul>
                <li>Create container images with Red Hat OpenShift Pipelines and use webhooks to trigger automated
                  builds.</li>
                <li>Work with Red Hat OpenShift Dev Spaces for an integrated development experience in the browser.</li>
                <li>Deploy and promote the application into several environments using Red Hat OpenShift GitOps.</li>
              </ul>
              <p>
                This workshop provisions an OpenShift cluster for each attendee.
                Make sure to increase the User Count to your desired capacity when ordering the item.
                You'll then receive an email once provisioned, including a usertool for users (1..100) to login to with
                their respective generated username and password "openshift" for access to the OpenShift Web Console,
                ArgoCD, and more.
                Enjoy, and don't forget to rate if the lab helped you learn!
              </p>
              <p><strong>Sample Workshop Guide:</strong> <a
                  href="https://redhat-scholars.github.io/inner-outer-guides">Hosted on Red Hat Scholars</a></p>
              <p><strong>Workshop Slides:</strong> <a
                  href="https://docs.google.com/presentation/d/1aJtBza3oHS0W0keAEYIUk5kw3O5-Z1mKw49abRHQqio">Hosted on
                  Google Slides</a></p>
              <p><strong>Duration:</strong> ~1 hour</p>
              <p><strong>Audience:</strong> Developers, Operations, Cluster Administrators</p>
              <p>
                <strong>Source Repositories:</strong>
                <a href="https://github.com/redhat-scholars/inner-outer-guides">Guide</a>,
                <a href="https://github.com/blues-man/vote-app-gitops">GitOps Manifests</a>
              </p>
            </td>
          </tr>
        </tbody>
      </table>
    </div>


    <!-- Important Information about your Environment -->
    <div style="margin:0px auto;max-width:650px;">
      <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
        <tbody>
          <tr>
            <td colspan="3"
              style="font-size:16px;color:#f8f8f8;background:#f40e0e;font-weight:700;word-break:break-word;height:25px;border-radius:0px;text-align:left;">
              Important Information About Your Environment
            </td>
          </tr>
          <tr>
            <th style="color:#F3F3F3;background:#151515;width: 150px;border-radius:0px;">
              Description
            </th>
            <th style="color:#F3F3F3;background:#151515;width: 100px;border-radius:0px;">
              Type
            </th>
            <th style="color:#F3F3F3;background:#151515;width: 350px;border-radius:0px;">
              Details
            </th>
          </tr>
          <!-- Automation Controller -->
          <tr>
            <td colspan="3" style="background:#ffffff;"></td>
          </tr>
          <tr>
            <td rowspan="4" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              OpenShift
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Console URL
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ openshift_console_url }}
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Username
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ openshift_admin_user }}
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Password
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ openshift_admin_password }}
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              oc login
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              oc login -u {{ openshift_cluster_admin_username }} -p {{ openshift_cluster_admin_password }} {{
              openshift_api_url }}
            </td>
          </tr>

          <!-- GitLab -->

          <tr>
            <td colspan="3" style="background:#ffffff;"></td>
          </tr>
          <tr>
            <td rowspan="3" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              GitLab
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              URL
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ gitlab_url }}
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Users
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              user1 .. userX
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Password
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ gitlab_user_password }}
            </td>
          </tr>

          <!-- DevSpaces -->

          <tr>
            <td colspan="3" style="background:#ffffff;"></td>
          </tr>
          <tr>
            <td rowspan="3" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              DevSpaces
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              URL
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ devspaces_url }}
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Users
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              user1 .. userX
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Password
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ devspaces_user_password }}
            </td>
          </tr>

          <!-- Red Hat Developer Hub -->

          <tr>
            <td colspan="3" style="background:#ffffff;"></td>
          </tr>
          <tr>
            <td rowspan="3" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              Red Hat Developer Hub
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              URL
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ rhdh_url }}
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Users
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              user1 .. userX
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Password
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ rhdh_user_password }}
            </td>
          </tr>

          <!-- OpenShift Gitops ArgoCD -->

          <tr>
            <td colspan="3" style="background:#ffffff;"></td>
          </tr>
          <tr>
            <td rowspan="2" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              OpenShift GitOps ArgoCD
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              URL
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ argocd_url }}
            </td>
          </tr>
          <tr>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Login
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              Login via OpenShift
            </td>
          </tr>

          <!-- Service management URL -->

          <tr>
            <td colspan="3" style="background:#ffffff;"></td>
          </tr>
          <tr>
            <td rowspan="2" style="color:#000000;background:#F3F3F3;font-weight:700;font-size:14px;border-radius:0px;">
              Service Management
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              URL
            </td>
            <td style="color:#000000;background:#F3F3F3;border-radius:0px;">
              {{ service_url }}
            </td>
          </tr>

        </tbody>
      </table>
    </div>
    <!-- Empty/space -->
    <div style="margin:0px auto;max-width:650px;height:50px;">&nbsp;</div>
    <!-- Copy Right -->
    <table align="center" cellpadding="0" cellspacing="0" role="presentation"
      style=";border:0px;background:#151515;width:100%;padding:0 0 0 0;text-align:center;">
      <tbody>
        <tr>
          <td></td>
      </tbody>
    </table>
  </div>
  <!-- Main end -->
  <!-- Empty/space -->
  &nbsp;
</body>

</html>